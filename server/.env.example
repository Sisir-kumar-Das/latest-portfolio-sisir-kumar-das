# Express server port
PORT=5000

# Allowed frontend origin(s) for CORS. Comma-separate multiple origins,
# e.g. http://localhost:5173,https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Optional MongoDB connection string. Leave empty to run without persistence.
MONGODB_URI=

# Active LLM provider: mock | openai | groq | gemini | anthropic
LLM_PROVIDER=mock

# Provider API keys
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional override for provider-specific default model.
# Defaults: openai=gpt-4o-mini, groq=llama-3.1-8b-instant,
# gemini=gemini-3.5-flash-lite, anthropic=claude-3-5-haiku-latest.
LLM_MODEL=

# Optional, raises GitHub API rate limit for live stats
GITHUB_TOKEN=
